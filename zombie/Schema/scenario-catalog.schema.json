{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/zombie/scenario-catalog.schema.json",
  "title": "zombie scenario catalog",
  "type": "object",
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "wikipedia", "accessed", "confidence", "notes"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "wikipedia": { "type": "string", "format": "uri" },
        "accessed": { "type": "string" },
        "confidence": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      }
    },
    "force": {
      "type": "object",
      "required": ["id", "name", "side", "unit", "sourceNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "side": { "enum": ["player", "opponent"] },
        "unit": { "type": "string" },
        "sourceNote": { "type": "string" }
      }
    },
    "actor": {
      "type": "object",
      "required": ["id", "name", "side", "role", "position", "weapon", "stats", "skills", "sourceNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "side": { "enum": ["player", "opponent"] },
        "role": { "type": "string" },
        "position": { "$ref": "#/$defs/point" },
        "weapon": { "type": "string" },
        "stats": { "type": "object" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "sourceNote": { "type": "string" }
      }
    },
    "terrainTag": {
      "enum": ["road", "lane", "field", "hedge", "wall", "building", "checkpoint", "base", "border", "river", "rail", "cover", "elevation", "protected", "exit", "objective", "helipad"]
    },
    "movementProfile": {
      "type": "object",
      "required": ["defaultCost", "roadCost", "coverCost", "blockedTags", "notes"],
      "properties": {
        "defaultCost": { "type": "integer", "minimum": 1 },
        "roadCost": { "type": "integer", "minimum": 1 },
        "coverCost": { "type": "integer", "minimum": 1 },
        "blockedTags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/terrainTag" }
        },
        "notes": { "type": "string" }
      }
    },
    "mapCell": {
      "type": "object",
      "required": ["point", "tags"],
      "properties": {
        "point": { "$ref": "#/$defs/point" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/terrainTag" }
        }
      }
    },
    "map": {
      "type": "object",
      "required": ["width", "height", "cellYards", "cells", "protectedCells", "notes"],
      "properties": {
        "width": { "type": "integer", "minimum": 4 },
        "height": { "type": "integer", "minimum": 4 },
        "cellYards": { "type": "integer", "minimum": 1 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/mapCell" }
        },
        "protectedCells": {
          "type": "array",
          "items": { "$ref": "#/$defs/point" }
        },
        "movement": { "$ref": "#/$defs/movementProfile" },
        "notes": { "type": "string" }
      }
    },
    "objective": {
      "type": "object",
      "required": ["kind", "point", "description", "turnLimit"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "point": { "$ref": "#/$defs/point" },
        "description": { "type": "string" },
        "turnLimit": { "type": "integer", "minimum": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["schemaVersion", "id", "title", "date", "place", "tier", "playable", "forces", "actors", "map", "objective", "mechanics", "source", "sensitivityTags", "implementationNotes"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 1 },
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 10 },
        "place": { "type": "string", "minLength": 1 },
        "tier": { "enum": ["early", "vehicle", "checkpoint", "aircraft", "mortar", "deferred", "excluded"] },
        "playable": { "type": "boolean" },
        "forces": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/force" } },
        "actors": { "type": "array", "items": { "$ref": "#/$defs/actor" } },
        "mapFile": { "type": "string", "minLength": 1 },
        "map": { "$ref": "#/$defs/map" },
        "objective": { "$ref": "#/$defs/objective" },
        "mechanics": {
          "type": "object",
          "properties": {
            "vehicles": { "type": "array" },
            "explosives": { "type": "array" },
            "checkpoints": { "type": "array" },
            "aircraft": { "type": "array" },
            "indirectFire": { "type": "array" },
            "structures": { "type": "array" },
            "phases": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dataConfidence": {
          "type": "object",
          "properties": {
            "roster": { "type": "string" },
            "map": { "type": "string" },
            "weapons": { "type": "string" },
            "timing": { "type": "string" }
          }
        },
        "scopeWarning": { "type": "string" },
        "collections": { "type": "array", "items": { "type": "string" } },
        "source": { "$ref": "#/$defs/source" },
        "sensitivityTags": { "type": "array", "items": { "type": "string" } },
        "implementationNotes": { "type": "string" }
      }
    }
  }
}
